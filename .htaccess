# Disable directory listing across the entire project
Options -Indexes

# Block public access to SQL dumps, git, env, and configuration files
<FilesMatch "\.(sql|env|ini|log|sh|bak|zip)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
